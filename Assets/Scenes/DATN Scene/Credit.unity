--- !u!114 &1905942886
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1905942885}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ba6c8c626bcf3c148a7968527508e1ae, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  creditText: {fileID: 206731782}
  viewport: {fileID: 207412187}
  textRect: {fileID: 1443061081}
  creditContent: "===== ALONE SURVIVOR: SINH T\u1ED2N M\u1ED8T M\xCCNH =====\r\n\r\nTR\u01AF\u1EDCNG
    CAO \u0110\u1EB2NG FPT POLYTECHNIC T\xC2Y NGUY\xCAN\r\nL\u1EDBp: GAM19301\r\nNi\xEAn
    kh\xF3a: 2023 - 2025\r\n\r\nGI\xC1O VI\xCAN H\u01AF\u1EDANG D\u1EAAN\r\nNguy\u1EC5n
    Trung Hi\u1EBFu\r\n\r\nNH\xD3M PH\xC1T TRI\u1EC2N \u2013 THE CHICKENS STUDIO\r\nLeader
    \u2013 Thi\u1EBFt k\u1EBF m\xE0n ch\u01A1i, t\xE0i li\u1EC7u GDD/TDD, qu\u1EA3n
    l\xFD ti\u1EBFn \u0111\u1ED9:\r\n   Ph\u1EA1m Vi\u1EC7t H\xF9ng (PK03596)\r\n\r\nL\u1EADp
    tr\xECnh ch\xEDnh \u2013 Di chuy\u1EC3n, t\u1EA5n c\xF4ng nh\xE2n v\u1EADt, h\u1EC7
    th\u1ED1ng nhi\u1EC7m v\u1EE5, t\xEDch h\u1EE3p:\r\n   Ho\xE0ng Minh V\u0169
    (PK03727)\r\n\r\nAI & Animation \u2013 Qu\xE1i v\u1EADt, Boss, c\xE2n b\u1EB1ng
    \u0111\u1ED9 kh\xF3, t\u1ED1i \u01B0u h\xE0nh vi:\r\n   \u0110\u1ED7 L\xEA Minh
    Trung (PK03802)\r\n\r\nUI/UX \u2013 Menu, b\u1EA3ng x\u1EBFp h\u1EA1ng, \u0111\u0103ng
    k\xFD/\u0111\u0103ng nh\u1EADp, HUD, popup:\r\n   Nguy\u1EC5n Qu\u1ED1c T\u01B0\u1EDDng
    (PK03750)\r\n\r\nQUY TR\xCCNH V\xC0 C\xD4NG C\u1EE4\r\nC\xF4ng ngh\u1EC7: Unity
    2022.3.16f1, C#, Visual Studio\r\nQu\u1EA3n l\xFD: GitHub, Jira, Google Sheet\r\nT\xE0i
    nguy\xEAn: Mixamo (Animation), Unity Asset Store, Itch.io (Asset)\r\n\r\nM\u1ED0C
    TH\u1EDCI GIAN\r\n01/06/2025 \u2013 14/08/2025: Thi\u1EBFt k\u1EBF, hi\u1EC7n
    th\u1EF1c, ki\u1EC3m th\u1EED, t\u1ED1i \u01B0u\r\n01/08/2025: Ra m\u1EAFt phi\xEAn
    b\u1EA3n ch\xEDnh th\u1EE9c\r\n14/08/2025: T\u1ED5ng k\u1EBFt, \u0111\xF3ng g\xF3i
    b\xE1o c\xE1o\r\n\r\n\u0110\u1EB6C \u0110I\u1EC2M N\u1ED4I B\u1EACT\r\nH\u1EC7
    th\u1ED1ng chi\u1EBFn \u0111\u1EA5u theo nh\u1ECBp, c\u1EA3m gi\xE1c va ch\u1EA1m
    r\xF5 r\xE0ng\r\nAI k\u1EBB \u0111\u1ECBch \u0111a d\u1EA1ng, Boss c\xF3 pha
    chuy\u1EC3n giai \u0111o\u1EA1n\r\nNhi\u1EC7m v\u1EE5 theo ti\u1EBFn \u0111\u1ED9
    c\u1ED1t truy\u1EC7n\r\nGiao di\u1EC7n tr\u1EF1c quan, h\u1ED7 tr\u1EE3 b\xE0n
    ph\xEDm\r\nBuild \u0111\u01B0\u1EE3c cho PC v\xE0 WebGL\r\n\r\nPH\xC1T H\xC0NH\r\nN\u1EC1n
    t\u1EA3ng: PC (Windows) v\xE0 WebGL\r\n\r\n\u0110\u1ECANH H\u01AF\u1EDANG T\u01AF\u01A0NG
    LAI\r\nTh\xEAm b\u1EA3n \u0111\u1ED3 m\u1EDBi, h\u1EC7 th\u1ED1ng k\u1EF9 n\u0103ng
    b\u1ECB \u0111\u1ED9ng\r\nB\u1EA3ng x\u1EBFp h\u1EA1ng tr\u1EF1c tuy\u1EBFn v\xE0
    nhi\u1EC7m v\u1EE5 h\u1EB1ng ng\xE0y\r\nT\xEDch h\u1EE3p l\u01B0u tr\u1EEF Playfab
    \r\n\r\nL\u1EDCI C\u1EA2M \u01A0N\r\nXin ch\xE2n th\xE0nh c\u1EA3m \u01A1n th\u1EA7y
    Nguy\u1EC5n Trung Hi\u1EBFu \u0111\xE3 t\u1EADn t\xECnh h\u01B0\u1EDBng d\u1EABn.\r\nC\u1EA3m
    \u01A1n c\xE1c b\u1EA1n l\u1EDBp GAM19301 \u0111\xE3 g\xF3p \xFD v\xE0 h\u1ED7
    tr\u1EE3 xuy\xEAn su\u1ED1t qu\xE1 tr\xECnh th\u1EF1c hi\u1EC7n.\r\nC\u1EA3m
    \u01A1n c\u1ED9ng \u0111\u1ED3ng FPT Polytechnic \u0111\xE3 \u0111\u1ED3ng h\xE0nh,
    \u0111\u1ED9ng vi\xEAn, v\xE0 chia s\u1EBB ki\u1EBFn th\u1EE9c.\r\n\r\n=====
    XIN CH\xC2N TH\xC0NH C\u1EA2M \u01A0N  =====\r\n\r\n\r\n"
